{
  "version": 2,
  "builds": [
    {
      "src": "api/status.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/chat.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/status",
      "dest": "api/status.py"
    },
    {
      "src": "/api/chat",
      "dest": "api/chat.py"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
