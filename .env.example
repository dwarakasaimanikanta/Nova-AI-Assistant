# -----------------------------------------------------------------
# Nova AI Assistant - Environment Variable Template
# -----------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
# The ".env" file itself is git-ignored and must NEVER be committed,
# since it will contain real secret keys.
#
#   cp .env.example .env
# -----------------------------------------------------------------

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Provider keys (used starting Phase 1 core engine integration)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Web search provider (used starting Phase 1 web_search skill)
SEARCH_API_KEY=your_search_api_key_here
